{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh" }]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(npm run *)", "Bash(npm test)", "Bash(npm ci)", "Bash(python3 tests/*)", "Bash(git status)", "Bash(git diff *)"]
  }
}
