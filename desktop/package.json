{
  "name": "pdf-editor-desktop",
  "productName": "PDF Editor",
  "version": "1.2.0",
  "description": "Private PDF editor for Windows, macOS and Linux",
  "author": "TEKDIGIX",
  "main": "main.js",
  "scripts": {
    "copy-app": "node copy-app.js",
    "start": "npm run copy-app && electron .",
    "dist": "npm run copy-app && electron-builder",
    "dist:win": "npm run copy-app && electron-builder --win",
    "dist:mac": "npm run copy-app && electron-builder --mac",
    "dist:linux": "npm run copy-app && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tekdigix.pdfeditor",
    "productName": "PDF Editor",
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}